CREATE TABLE Books (
    book_id          INT IDENTITY(1,1) NOT NULL,
    author_id        INT           NOT NULL,
    title            VARCHAR(200)  NOT NULL,
    publication_year INT           NULL,
    page_count       INT           NULL,
    publisher        VARCHAR(100)  NULL,
    CONSTRAINT PK_Books PRIMARY KEY (book_id),
    CONSTRAINT FK_Books_Authors FOREIGN KEY (author_id)
        REFERENCES Authors (author_id)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);

CREATE TABLE Subscriptions (
    reader_id     INT  NOT NULL,
    book_id       INT  NOT NULL,
    issue_date    DATE NOT NULL,
    period        INT  NOT NULL,
    return_status BIT  NOT NULL DEFAULT 0,
    CONSTRAINT PK_Subscriptions PRIMARY KEY (reader_id, book_id, issue_date),
    CONSTRAINT FK_Subscriptions_Books FOREIGN KEY (book_id)
        REFERENCES Books (book_id)
        ON UPDATE CASCADE
        ON DELETE CASCADE
);







